# Copy to deploy.env and fill in your values:
#   cp deploy.env.example deploy.env
#
# Load before running gcloud commands from DEPLOY.md:
#   source deploy.env

PROJECT_ID=your-gcp-project-id
REGION=europe-west1
SERVICE=multi-agent-orchestrator

# Set after Vercel deploy (step 1)
# VERCEL_URL=https://your-app.vercel.app

# Set after Cloud Run deploy (step 3)
# API_URL=https://multi-agent-orchestrator-xxxxx-ew.a.run.app
